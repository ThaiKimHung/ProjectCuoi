    "test": "node --test tests"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "fs-extra": "^11.3.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
